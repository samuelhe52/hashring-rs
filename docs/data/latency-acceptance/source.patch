+        let end = after.get(node).copied().unwrap_or_default();
+        let ops_handled = end.ops_handled.saturating_sub(start.ops_handled);
+        let cpu_percent = if seconds > 0.0 {
+            (end.cpu_seconds - start.cpu_seconds) / seconds * 100.0
+        } else {
+            0.0
+        };
