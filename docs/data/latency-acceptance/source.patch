+/// The clock ticks the kernel counts CPU time in.
+fn clock_ticks_per_second() -> u64 {
+    static TICKS: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
+    *TICKS.get_or_init(|| {
+        command_output(None, "getconf", &["CLK_TCK"])
+            .and_then(|value| value.trim().parse().ok())
+            .unwrap_or(100)
+    })
+}
