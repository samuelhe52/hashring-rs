-pub(super) fn complete_required_acks(
-    state: &mut NodeState,
-    mutation_id: &str,
-    version: &RecordVersion,
-) {
+/// Releases the ACK lists queued by `wait_required_acks`. A retry that reaches
+/// a receipt before this runs still finds its ACK list and waits on ACKs that
+/// already arrived, which returns at once while the follower is unchanged.
+pub(super) fn apply_completed_acks(state: &mut NodeState) {
+    let queue = state
+        .completed_acks
+        .get_mut()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if queue.is_empty() {
+        return;
+    }
+    let mut completed = std::mem::take(queue);
+    for (mutation_id, version) in completed.drain(..) {
+        complete_required_acks(state, &mutation_id, &version);
+    }
+    // Pushers hold the read lock, so nothing was queued meanwhile; keep the
+    // allocation for the next batch.
+    *state
+        .completed_acks
+        .get_mut()
+        .unwrap_or_else(std::sync::PoisonError::into_inner) = completed;
+}
+
